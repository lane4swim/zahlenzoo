{
  "version": "0.1-stilprobe",
  "stroke": {
    "main": 4,
    "inner": 2.5,
    "base_figure_px": 512,
    "rule": "4 px bei 512 px Figurenhöhe; Innenlinien 2.5 px; runde Enden und Ecken"
  },
  "light": "oben links, höchstens eine Schattenstufe",
  "fonts": {
    "text": "Andika (SIL OFL)",
    "display": "Fredoka (SIL OFL)",
    "install": "npm i @fontsource/andika @fontsource/fredoka (selbst gehostet, kein Google-CDN)"
  },
  "colors": {
    "kontur": {
      "hex": "#4A3426",
      "use": "Konturen, Text auf hellen Flächen"
    },
    "text": {
      "hex": "#3A2A20",
      "use": "Fließtext und Ziffern im Spiel"
    },
    "papier": {
      "hex": "#FFF8EC",
      "use": "Karten, Tasten, helle Flächen"
    },
    "karte-schatten": {
      "hex": "#E8D3A8",
      "use": "Tastenkante, leere Sterne"
    },
    "himmel": {
      "hex": "#BFE6F2",
      "use": "Himmel"
    },
    "himmel-tief": {
      "hex": "#8FCDE3",
      "use": "Himmel oben, Wasser hell"
    },
    "wasser": {
      "hex": "#5BB8D9",
      "use": "Wasser, Zehnerstangen"
    },
    "gras-hell": {
      "hex": "#B5E08F",
      "use": "Boden"
    },
    "gras": {
      "hex": "#8CCB6B",
      "use": "Hügel, richtig-Symbol"
    },
    "gras-dunkel": {
      "hex": "#5FA84F",
      "use": "Schattenseiten Vegetation"
    },
    "laub": {
      "hex": "#3F8F4F",
      "use": "Baumkronen, Ranken"
    },
    "laub-hell": {
      "hex": "#A9D98F",
      "use": "ferne Hügel (ohne Kontur)"
    },
    "sonne": {
      "hex": "#FFD25A",
      "use": "Sonne, Banane, Glühbirne"
    },
    "stern": {
      "hex": "#FFC83D",
      "use": "Sterne"
    },
    "orange": {
      "hex": "#FFB347",
      "use": "Einerwürfel, Zähler, weicher Hinweis"
    },
    "rosa": {
      "hex": "#FF8FA3",
      "use": "Wangen, Zunge, Blumen"
    },
    "ohr-rosa": {
      "hex": "#F7B7A6",
      "use": "Innenohr"
    },
    "erde": {
      "hex": "#C98F5A",
      "use": "Baumstämme, Wege"
    },
    "weiss": {
      "hex": "#FFFFFF",
      "use": "Glanzlichter, Wolken"
    },
    "mund": {
      "hex": "#8C3B33",
      "use": "Mundinneres"
    },
    "grau-warm": {
      "hex": "#C9BBA3",
      "use": "Sockel, Silhouetten"
    },
    "affe-fell": {
      "hex": "#B9794A",
      "use": "Affe Fell"
    },
    "affe-hell": {
      "hex": "#F1CFA0",
      "use": "Affe Gesicht und Bauch"
    },
    "affe-dunkel": {
      "hex": "#8F5A34",
      "use": "Affe Haarschopf und Nase"
    },
    "pinguin-gefieder": {
      "hex": "#6C8EA3",
      "use": "Pinguin Rücken und Kopf"
    },
    "elefant-haut": {
      "hex": "#A3A9B8",
      "use": "Elefant Haut"
    }
  },
  "shadow": {
    "color": "kontur",
    "opacity": 0.14,
    "rule": "nur Bodenschatten, flache Ellipse"
  }
}